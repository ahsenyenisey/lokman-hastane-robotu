<?xml version="1.0" ?>
<!--
  LOKMAN için hastane katı koridoru.

  KAT PLANI (üstten, ölçüler metre):

        y
        ↑                    ┌──────┐ y=10
        │                    │BANKO │
        │                    │      │
        │                    │  👤  │  ← ayakta duran hemşire (y≈4.5)
        │                    │      │
   1.2  ├────────────────────┘      │
        │ 🤖→  ⚠   ▭sedye  ▪  ♿  ▬▬▬ │
  -1.2  ├───────────────────────────┘
       x=-2                         x=12

  - Ana koridor: x = -2 … 12, genişlik 2.4 m (y = -1.2 … 1.2)
  - Yan koridor: x = 9.6 … 12, y = 1.2 … 10 (L şekli: robot köşe dönmek zorunda)
  - 2.4 m genişlik: iki sedyenin yan yana geçebileceği bir hastane koridoru

  ENGELLER VE NEDEN SEÇİLDİKLERİ:
  ⚠  Islak zemin uyarı levhası : hastanede en sık rastlanan geçici engel
  ▭  Sedye                     : 2D LiDAR yalnızca İNCE AYAKLARINI görür → alçak LiDAR gerekçesi
  ▪  Devrik tabure (0.2 m)     : LiDAR düzleminin (0.33 m) ALTINDA → LiDAR göremez, bumper yakalar
  ♿  Tekerlekli sandalye       : büyük tekerlekleri ve alçak ayaklığıyla düzensiz bir engel
  ▬  Bekleme sıraları         : duvar boyunca uzanan, koridoru daraltan engel
  👤 Hemşire                   : LiDAR'da iki küçük daire olarak görünen bacaklar (insan algısı)
  BANKO Hemşire bankosu       : yan koridorun sonu
  Tüm modeller basit geometrik şekillerden, internetten model indirmeden yapılmıştır.
-->
<sdf version="1.10">
  <world name="hastane_koridoru">

    <!-- Fizik: 2 ms adım; yazılımsal render altında işlemciyi rahatlatır -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Dünya eklentileri. Dünya dosyasında eklenti tanımlanınca varsayılanlar
         yüklenmez, bu yüzden hepsini açıkça yazıyoruz. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensör sistemleri (Aşama 4'te LiDAR, kamera, IMU ve bumper bunları kullanacak) -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>false</shadows>  <!-- gölgeler yazılımsal render'da çok yavaş -->
    </scene>

    <!-- Tavan lambası gibi yukarıdan gelen ışık -->
    <light type="directional" name="tavan_isigi">
      <cast_shadows>false</cast_shadows>
      <pose>5 3 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- ================= ZEMİN: açık yeşil-gri hastane PVC'si ================= -->
    <model name="zemin">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.72 0.78 0.75 1</ambient>
            <diffuse>0.72 0.78 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= DUVARLAR (krem rengi, 2.5 m yükseklik) ================= -->
    <model name="duvarlar">
      <static>true</static>
      <link name="link">
        <!-- Ana koridor güney duvarı -->
        <collision name="guney_c"><pose>5 -1.275 1.25 0 0 0</pose>
          <geometry><box><size>14.3 0.15 2.5</size></box></geometry></collision>
        <visual name="guney_v"><pose>5 -1.275 1.25 0 0 0</pose>
          <geometry><box><size>14.3 0.15 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Ana koridor kuzey duvarı (yan koridora kadar) -->
        <collision name="kuzey_c"><pose>3.725 1.275 1.25 0 0 0</pose>
          <geometry><box><size>11.75 0.15 2.5</size></box></geometry></collision>
        <visual name="kuzey_v"><pose>3.725 1.275 1.25 0 0 0</pose>
          <geometry><box><size>11.75 0.15 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Doğu duvarı (iki koridor boyunca) -->
        <collision name="dogu_c"><pose>12.075 4.35 1.25 0 0 0</pose>
          <geometry><box><size>0.15 11.4 2.5</size></box></geometry></collision>
        <visual name="dogu_v"><pose>12.075 4.35 1.25 0 0 0</pose>
          <geometry><box><size>0.15 11.4 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Yan koridor batı duvarı -->
        <collision name="yan_bati_c"><pose>9.525 5.6 1.25 0 0 0</pose>
          <geometry><box><size>0.15 8.8 2.5</size></box></geometry></collision>
        <visual name="yan_bati_v"><pose>9.525 5.6 1.25 0 0 0</pose>
          <geometry><box><size>0.15 8.8 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Yan koridor sonu (kuzey) -->
        <collision name="son_c"><pose>10.8 10.075 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.15 2.5</size></box></geometry></collision>
        <visual name="son_v"><pose>10.8 10.075 1.25 0 0 0</pose>
          <geometry><box><size>2.7 0.15 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Ana koridor başı (batı) -->
        <collision name="bas_c"><pose>-2.075 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.7 2.5</size></box></geometry></collision>
        <visual name="bas_v"><pose>-2.075 0 1.25 0 0 0</pose>
          <geometry><box><size>0.15 2.7 2.5</size></box></geometry>
          <material><ambient>0.93 0.91 0.86 1</ambient><diffuse>0.93 0.91 0.86 1</diffuse></material></visual>

        <!-- Turkuaz duvar koruma bandı (sedye çarpmalarına karşı; gerçek hastanelerde bulunur) -->
        <visual name="bant_guney"><pose>5 -1.19 0.9 0 0 0</pose>
          <geometry><box><size>14.3 0.03 0.15</size></box></geometry>
          <material><ambient>0 0.6 0.6 1</ambient><diffuse>0 0.6 0.6 1</diffuse></material></visual>
        <visual name="bant_kuzey"><pose>3.725 1.19 0.9 0 0 0</pose>
          <geometry><box><size>11.75 0.03 0.15</size></box></geometry>
          <material><ambient>0 0.6 0.6 1</ambient><diffuse>0 0.6 0.6 1</diffuse></material></visual>
        <visual name="bant_dogu"><pose>11.99 4.35 0.9 0 0 0</pose>
          <geometry><box><size>0.03 11.4 0.15</size></box></geometry>
          <material><ambient>0 0.6 0.6 1</ambient><diffuse>0 0.6 0.6 1</diffuse></material></visual>
        <visual name="bant_yan_bati"><pose>9.61 5.6 0.9 0 0 0</pose>
          <geometry><box><size>0.03 8.8 0.15</size></box></geometry>
          <material><ambient>0 0.6 0.6 1</ambient><diffuse>0 0.6 0.6 1</diffuse></material></visual>

        <!-- Hasta odası kapıları (ahşap renkli, 1.0 m genişlik, 2.1 m yükseklik) -->
        <visual name="kapi_1"><pose>0.5 1.19 1.05 0 0 0</pose>
          <geometry><box><size>1.0 0.04 2.1</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual>
        <visual name="kapi_2"><pose>6.5 1.19 1.05 0 0 0</pose>
          <geometry><box><size>1.0 0.04 2.1</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual>
        <visual name="kapi_3"><pose>2.5 -1.19 1.05 0 0 0</pose>
          <geometry><box><size>1.0 0.04 2.1</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual>
        <visual name="kapi_4"><pose>9.61 7.0 1.05 0 0 0</pose>
          <geometry><box><size>0.04 1.0 2.1</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= ISLAK ZEMİN UYARI LEVHASI (sarı, A şeklinde) ================= -->
    <model name="islak_zemin_levhasi">
      <static>true</static>
      <pose>1.3 -0.5 0 0 0 0</pose>
      <link name="link">
        <collision name="on_c"><pose>0.08 0 0.3 0 -0.25 0</pose>
          <geometry><box><size>0.02 0.3 0.62</size></box></geometry></collision>
        <visual name="on_v"><pose>0.08 0 0.3 0 -0.25 0</pose>
          <geometry><box><size>0.02 0.3 0.62</size></box></geometry>
          <material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>
        <collision name="arka_c"><pose>-0.08 0 0.3 0 0.25 0</pose>
          <geometry><box><size>0.02 0.3 0.62</size></box></geometry></collision>
        <visual name="arka_v"><pose>-0.08 0 0.3 0 0.25 0</pose>
          <geometry><box><size>0.02 0.3 0.62</size></box></geometry>
          <material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= SEDYE (kuzey duvarı önüne park edilmiş) =================
         LiDAR 0.33 m'de tarar: yatağı DEĞİL, yalnızca 4 ince ayağı görür. -->
    <model name="sedye">
      <static>true</static>
      <pose>3.6 0.72 0 0 0 0</pose>
      <link name="link">
        <!-- Yatak çerçevesi ve şilte -->
        <collision name="cerceve_c"><pose>0 0 0.64 0 0 0</pose>
          <geometry><box><size>1.9 0.62 0.06</size></box></geometry></collision>
        <visual name="cerceve_v"><pose>0 0 0.64 0 0 0</pose>
          <geometry><box><size>1.9 0.62 0.06</size></box></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <visual name="silte_v"><pose>0 0 0.72 0 0 0</pose>
          <geometry><box><size>1.85 0.58 0.1</size></box></geometry>
          <material><ambient>0.55 0.75 0.9 1</ambient><diffuse>0.55 0.75 0.9 1</diffuse></material></visual>
        <!-- 4 ayak -->
        <collision name="ayak1_c"><pose>0.85 0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry></collision>
        <visual name="ayak1_v"><pose>0.85 0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <collision name="ayak2_c"><pose>0.85 -0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry></collision>
        <visual name="ayak2_v"><pose>0.85 -0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <collision name="ayak3_c"><pose>-0.85 0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry></collision>
        <visual name="ayak3_v"><pose>-0.85 0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <collision name="ayak4_c"><pose>-0.85 -0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry></collision>
        <visual name="ayak4_v"><pose>-0.85 -0.26 0.32 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.62</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= DEVRİK TABURE (0.2 m, LiDAR düzleminin altında) =================
         Bilerek yolun ortasına konuldu: LiDAR göremez, bumper'ın neden gerekli
         olduğunu demoda gösterir. -->
    <model name="devrik_tabure">
      <static>true</static>
      <pose>5.2 -0.1 0 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><pose>0 0 0.1 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.2</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.1 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.2</size></box></geometry>
          <material><ambient>0.15 0.25 0.55 1</ambient><diffuse>0.15 0.25 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= TEKERLEKLİ SANDALYE ================= -->
    <model name="tekerlekli_sandalye">
      <static>true</static>
      <pose>6.8 -0.72 0 0 0 0</pose>
      <link name="link">
        <!-- Oturak ve sırtlık -->
        <collision name="oturak_c"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.45 0.45 0.05</size></box></geometry></collision>
        <visual name="oturak_v"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.45 0.45 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
        <collision name="sirt_c"><pose>-0.22 0 0.78 0 0 0</pose><geometry><box><size>0.04 0.45 0.5</size></box></geometry></collision>
        <visual name="sirt_v"><pose>-0.22 0 0.78 0 0 0</pose><geometry><box><size>0.04 0.45 0.5</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
        <!-- Büyük arka tekerlekler -->
        <collision name="teker_sol_c"><pose>-0.08 0.27 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="teker_sol_v"><pose>-0.08 0.27 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <collision name="teker_sag_c"><pose>-0.08 -0.27 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="teker_sag_v"><pose>-0.08 -0.27 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <!-- Ön küçük tekerlek gövdeleri -->
        <collision name="on_sol_c"><pose>0.2 0.2 0.25 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="on_sol_v"><pose>0.2 0.2 0.25 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <collision name="on_sag_c"><pose>0.2 -0.2 0.25 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="on_sag_v"><pose>0.2 -0.2 0.25 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material></visual>
        <!-- Ayaklık: yerden 0.12 m, LiDAR'ın altında kalır -->
        <collision name="ayaklik_c"><pose>0.36 0 0.12 0 0 0</pose><geometry><box><size>0.2 0.4 0.03</size></box></geometry></collision>
        <visual name="ayaklik_v"><pose>0.36 0 0.12 0 0 0</pose><geometry><box><size>0.2 0.4 0.03</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= BEKLEME SIRALARI (güney duvarı boyunca) =================
         Alt kısmı kapalı gövde: robot oturağın altına girmeye çalışmasın diye.
         (2D LiDAR yalnızca kendi düzlemini görür; açık alt kısımlı bir sandalye
         robotu yanıltabilirdi. Bu, raporda "sınırlılıklar" başlığında tartışılabilir.) -->
    <model name="bekleme_siralari">
      <static>true</static>
      <pose>8.6 -0.95 0 0 0 0</pose>
      <link name="link">
        <collision name="govde_c"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>1.8 0.45 0.42</size></box></geometry></collision>
        <visual name="govde_v"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>1.8 0.45 0.42</size></box></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.45 0.47 0.5 1</diffuse></material></visual>
        <visual name="minder_v"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>1.8 0.45 0.05</size></box></geometry>
          <material><ambient>0 0.55 0.55 1</ambient><diffuse>0 0.55 0.55 1</diffuse></material></visual>
        <collision name="sirt_c"><pose>0 -0.2 0.75 0 0 0</pose><geometry><box><size>1.8 0.05 0.55</size></box></geometry></collision>
        <visual name="sirt_v"><pose>0 -0.2 0.75 0 0 0</pose><geometry><box><size>1.8 0.05 0.55</size></box></geometry>
          <material><ambient>0 0.55 0.55 1</ambient><diffuse>0 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= AYAKTA DURAN HEMŞİRE (yan koridorda) =================
         LiDAR'da iki küçük yay (bacaklar) olarak görünür. -->
    <model name="hemsire">
      <static>true</static>
      <pose>10.6 4.5 0 0 0 -1.2</pose>
      <link name="link">
        <collision name="bacak_sol_c"><pose>0 0.1 0.43 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.86</length></cylinder></geometry></collision>
        <visual name="bacak_sol_v"><pose>0 0.1 0.43 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.86</length></cylinder></geometry>
          <material><ambient>0.3 0.6 0.5 1</ambient><diffuse>0.3 0.6 0.5 1</diffuse></material></visual>
        <collision name="bacak_sag_c"><pose>0 -0.1 0.43 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.86</length></cylinder></geometry></collision>
        <visual name="bacak_sag_v"><pose>0 -0.1 0.43 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.86</length></cylinder></geometry>
          <material><ambient>0.3 0.6 0.5 1</ambient><diffuse>0.3 0.6 0.5 1</diffuse></material></visual>
        <collision name="govde_c"><pose>0 0 1.17 0 0 0</pose><geometry><box><size>0.24 0.42 0.62</size></box></geometry></collision>
        <visual name="govde_v"><pose>0 0 1.17 0 0 0</pose><geometry><box><size>0.24 0.42 0.62</size></box></geometry>
          <material><ambient>0.3 0.6 0.5 1</ambient><diffuse>0.3 0.6 0.5 1</diffuse></material></visual>
        <visual name="bas_v"><pose>0 0 1.6 0 0 0</pose><geometry><sphere><radius>0.11</radius></sphere></geometry>
          <material><ambient>0.85 0.68 0.55 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= HEMŞİRE BANKOSU (yan koridorun sonu) ================= -->
    <model name="hemsire_bankosu">
      <static>true</static>
      <pose>10.8 9.35 0 0 0 0</pose>
      <link name="link">
        <collision name="govde_c"><pose>0 0 0.53 0 0 0</pose><geometry><box><size>2.0 0.7 1.06</size></box></geometry></collision>
        <visual name="govde_v"><pose>0 0 0.53 0 0 0</pose><geometry><box><size>2.0 0.7 1.06</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="tezgah_v"><pose>0 0 1.08 0 0 0</pose><geometry><box><size>2.1 0.8 0.04</size></box></geometry>
          <material><ambient>0 0.6 0.6 1</ambient><diffuse>0 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
