<?xml version="1.0"?>
<!--
  Gazebo eklentileri (plugin): robotu hareket ettiren kısım.

  1) DiffDrive: /cmd_vel'den gelen hız komutunu (ileri hız + dönüş hızı)
     sol ve sağ teker hızlarına çevirir:
        v_sol = v - w * L/2      v_sag = v + w * L/2
     (v: ileri hız, w: dönüş hızı, L: teker aralığı)
     Ayrıca tekerlerin ne kadar döndüğünden robotun konumunu tahmin eder
     ve /odom olarak yayınlar (odometri). Odometri SENSÖR SAYILMAZ.

  2) JointStatePublisher: Teker açılarını /joint_states olarak yayınlar.
     RViz'de tekerlerin dönüşünü görmek için gerekli.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>sol_teker_joint</left_joint>
      <right_joint>sag_teker_joint</right_joint>
      <wheel_separation>${teker_aralik}</wheel_separation>
      <wheel_radius>${teker_r}</wheel_radius>

      <!-- Güvenlik sınırları (docs/tasarim.md: maks. 0.4 m/s).
           İvme sınırı, taşınan yükün sarsılmaması için yumuşak kalkış sağlar. -->
      <max_linear_velocity>0.4</max_linear_velocity>
      <min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>sol_teker_joint</joint_name>
      <joint_name>sag_teker_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
